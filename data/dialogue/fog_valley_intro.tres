[gd_resource type="Resource" script_class="DialogueData" load_steps=8 format=3]

[ext_resource type="Script" path="res://scripts/dialogue/dialogue_data.gd" id="1"]
[ext_resource type="Script" path="res://scripts/dialogue/dialogue_line_data.gd" id="2"]

[sub_resource type="Resource" id="Portal"]
script = ExtResource("2")
id = &"portal"
speaker_id = &"world"
text_key = &"异界气息仍在石环深处回响。"
emit_event_ids = Array[StringName]([&"portal_inspected"])

[sub_resource type="Resource" id="Mira"]
script = ExtResource("2")
id = &"mira"
speaker_id = &"mira"
text_key = &"米拉：雾起前采下的雾叶草效力最好。能替我采一株吗？"
set_flags = {&"mira_met": true}
emit_event_ids = Array[StringName]([&"mira_met"])

[sub_resource type="Resource" id="MiraAfterHerb"]
script = ExtResource("2")
id = &"mira_after_herb"
speaker_id = &"mira"
text_key = &"米拉：谢谢你。先把它带到炉火旁吧，暖光会让叶脉说出它的来处。"

[sub_resource type="Resource" id="MiraAfterHearth"]
script = ExtResource("2")
id = &"mira_after_hearth"
speaker_id = &"mira"
text_key = &"米拉：原来那道青光不属于雾谷。北方山口或许记得你从哪里来。"

[sub_resource type="Resource" id="Toren"]
script = ExtResource("2")
id = &"toren"
speaker_id = &"toren"
text_key = &"托伦：北边山口雾重。先沿石路去西侧药圃找米拉吧。"
emit_event_ids = Array[StringName]([&"toren_met"])

[sub_resource type="Resource" id="Nia"]
script = ExtResource("2")
id = &"nia"
speaker_id = &"nia"
text_key = &"尼娅：雾里的丝线，总会织出陌生的花纹。"
emit_event_ids = Array[StringName]([&"nia_met"])

[resource]
script = ExtResource("1")
id = &"fog_valley_intro"
start_line_id = &"portal"
lines = {&"portal": SubResource("Portal"), &"mira": SubResource("Mira"), &"mira_after_herb": SubResource("MiraAfterHerb"), &"mira_after_hearth": SubResource("MiraAfterHearth"), &"toren": SubResource("Toren"), &"nia": SubResource("Nia")}
